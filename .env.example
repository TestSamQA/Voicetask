# Copy to .env and fill in real values — never commit .env

# PostgreSQL
POSTGRES_DB=voicetask
POSTGRES_USER=voicetask
POSTGRES_PASSWORD=change_me_strong_password

# JWT — generate with: openssl rand -base64 48
JWT_SECRET=change_me_minimum_32_characters_long_random_string

# CORS — set to the URL you access the app from
ALLOWED_ORIGINS=http://localhost

# Port nginx binds on the host (default 80)
PORT=80

# Anthropic Claude (task extraction — no OpenAI key needed)
ANTHROPIC_API_KEY=sk-ant-...

# Pre-built images from GHCR — replace <owner> with your GitHub username/org
API_IMAGE=ghcr.io/<owner>/voicetask-api:main
WEB_IMAGE=ghcr.io/<owner>/voicetask-web:main
NGINX_IMAGE=ghcr.io/<owner>/voicetask-nginx:main
