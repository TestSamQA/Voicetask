# Copy to .env and fill in real values — never commit .env

# PostgreSQL
POSTGRES_DB=voicetask
POSTGRES_USER=voicetask
POSTGRES_PASSWORD=change_me_strong_password

# API
JWT_SECRET=change_me_minimum_32_characters_long_random_string
ALLOWED_ORIGINS=http://localhost:4200

# External APIs (Anthropic Claude for task extraction — no OpenAI key needed)
ANTHROPIC_API_KEY=sk-ant-...

# GHCR
API_IMAGE=ghcr.io/testsamqa/voicetask-api:main
WEB_IMAGE=ghcr.io/testsamqa/voicetask-web:main